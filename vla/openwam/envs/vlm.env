# Fixed-16 comparison — VLM + Wan runtime environment.
#
#   export OPENWAM_ENV=/path/to/venv && . envs/vlm.env
#
# Kept as a file rather than a habit: the settings below are the difference
# between a run that trains and a run that reports nan, and neither shows up as
# an error.

: "${OPENWAM_ENV:?set OPENWAM_ENV to the venv built from envs/vlm-requirements.txt}"
export PATH="${OPENWAM_ENV}/bin:${PATH}"

# NOT expandable_segments. On H200 + torch 2.7.1 + DeepSpeed ZeRO-2 + gradient
# checkpointing, PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True turns the loss
# to nan after the first optimizer step — finite at step 1, nan by step 3, no
# error, no NaN in the inputs or the gradients when the same steps are run
# without it. Qwen3-VL and Wan2.2 hit it; PaliGemma does not; H20 does not.
# Isolated by bisection, so unset it rather than inheriting it from a shell.
unset PYTORCH_CUDA_ALLOC_CONF
