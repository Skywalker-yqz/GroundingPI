# Fixed-16 comparison — Cosmos-Predict2.5 runtime environment.
#
#   export OPENWAM_ENV=/path/to/cosmos-venv && . envs/cosmos.env
#
# Cosmos needs a SEPARATE venv from the VLMs: cosmos-oss pins
# transformers==4.51.3, and Qwen3-VL requires >= 4.57.0. Build it with
#
#   python3 -m venv --system-site-packages <env>
#   PYBIN=<env>/bin/python bash scripts/install_cosmos_predict25.sh
#   printf '#!/bin/sh\nexec <env>/bin/python -m torch.distributed.run "$@"\n' > <env>/bin/torchrun
#   chmod +x <env>/bin/torchrun
#
# The install script needs third_party/cosmos-predict2.5 checked out and a CUDA
# toolkit; it builds transformer-engine from source, which takes a while.

: "${OPENWAM_ENV:?set OPENWAM_ENV to the venv built by scripts/install_cosmos_predict25.sh}"
export PATH="${OPENWAM_ENV}/bin:${PATH}"

# See envs/vlm.env — same allocator hazard, same reason.
unset PYTORCH_CUDA_ALLOC_CONF

# transformer-engine is built against the cuDNN torch ships, not the system one.
# Where the system copy is older, loading it first fails with
# `undefined symbol: cudnnGetLibConfig`, so put torch's ahead of it.
_CUDNN="$("${OPENWAM_ENV}/bin/python" -c 'import importlib.util, os; s = importlib.util.find_spec("nvidia.cudnn"); print(os.path.join(os.path.dirname(s.origin), "lib") if s else "")' 2>/dev/null)"
if [ -n "${_CUDNN}" ] && [ -d "${_CUDNN}" ]; then
    export LD_LIBRARY_PATH="${_CUDNN}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi
unset _CUDNN

# Fixing the library order is not enough on a mismatched cuDNN: TE's fused
# attention still aborts with CUDNN_STATUS_NOT_INITIALIZED. Fall back to the
# unfused kernel, which costs speed and nothing else. Drop this line if the
# system cuDNN matches the one TE was built against.
export NVTE_FUSED_ATTN=0
